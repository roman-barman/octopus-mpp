#!/usr/bin/env bash
# commit-msg: subject conventions and the OpenSpec reference in the body.
#
# The subject must be an imperative sentence of at most 72 characters,
# starting uppercase, without a trailing period. The body must cite the
# OpenSpec change and tasks the commit implements ("<change>: 1.2, 1.3") or,
# for the files the owner exempted from OpenSpec, say so explicitly
# ("No OpenSpec change: <reason>"). Install with scripts/hooks/install.sh.
set -euo pipefail
# shellcheck source=scripts/hooks/lib.sh
. "$(dirname "$0")/lib.sh"

# Apply git's own cleanup per commit.cleanup ("strip" drops comments and blank
# padding, "whitespace" keeps comments, "verbatim" keeps all; -v always cuts at
# the scissors line). Git uses "whitespace" for -m/-F even in default mode and
# the hook cannot tell (nor see --cleanup), so in default mode a leading
# comment line is refused unless the file looks like an editor template
# (several comment lines). A pasted text with 3+ comment lines is the known gap.
comment_char="$(git config --get core.commentString || git config --get core.commentChar || echo '#')"
[ "$comment_char" = "auto" ] && comment_char='#'
escaped_comment="$(printf '%s' "$comment_char" | sed 's/[][\\.*^$/]/\\&/g')"
scissors="^$escaped_comment ------------------------ >8 ------------------------\$"
cleanup="$(git config --get commit.cleanup || echo default)"
case "$cleanup" in
  verbatim) message="$(cat "$1")" ;;
  whitespace | scissors) message="$(sed "/$scissors/,\$d" "$1" | git stripspace)" ;;
  strip) message="$(sed "/$scissors/,\$d" "$1" | git stripspace --strip-comments)" ;;
  *)
    message="$(sed "/$scissors/,\$d" "$1" | git stripspace --strip-comments)"
    raw="$(git stripspace < "$1")"
    first_raw="${raw%%$'\n'*}"
    if [[ "$first_raw" == "$comment_char"* ]] && [ "$(grep -c "^$escaped_comment" "$1")" -lt 3 ]; then
      refuse "first line starts with the comment character '$comment_char'" \
        "line: $first_raw" \
        "with -m or -F git would commit it as the subject; reword it or set commit.cleanup"
    fi
    ;;
esac
[ -n "$message" ] || exit 0 # git aborts an empty message by itself
subject="${message%%$'\n'*}"
body="${message#"$subject"}"

# Exempt what git or the developer rewrites before it reaches a PR: fixup,
# squash and amend commits, merges (in progress, or git's own subject forms
# when a merge is amended) and git-generated reverts.
case "$subject" in
  "fixup! "* | "squash! "* | "amend! "* | 'Revert "'*) exit 0 ;;
  "Merge branch '"* | "Merge remote-tracking branch '"* | "Merge tag '"* | "Merge pull request #"*) exit 0 ;;
esac
if git rev-parse -q --verify MERGE_HEAD > /dev/null; then
  exit 0
fi

# Git makes the whole first paragraph the subject: a second line would be glued on.
if [[ "$body" == $'\n'[!$'\n']* ]]; then
  refuse "subject must be one line followed by a blank line" \
    "second line: ${body#$'\n'}"
fi

if [ "${#subject}" -gt 72 ]; then
  refuse "subject is longer than 72 characters" "subject: $subject" "length: ${#subject}"
fi
if ! [[ "$subject" =~ ^[A-Z] ]]; then
  refuse "subject must start with an uppercase letter" "subject: $subject"
fi
if [[ "$subject" == *. ]]; then
  refuse "subject must not end with a period" "subject: $subject"
fi

# Imperative mood is approximated by the first word's ending: "Added" and
# "Fixing" are refused. Imperative verbs that share those endings are listed
# here; extend the list by pull request when a new one is hit.
imperative_exceptions=" Bring Embed Exceed Feed Need Ping Proceed Ring Seed Shed Shred Speed Spread String Succeed Swing Thread "
first_word="${subject%% *}"
first_word="${first_word%%[^[:alpha:]]*}" # "Fixed:" is judged as "Fixed"
if [[ "$first_word" == *ed || "$first_word" == *ing ]] \
  && [[ "$imperative_exceptions" != *" $first_word "* ]]; then
  refuse "subject must start with an imperative verb (Add, not Added or Adding)" \
    "first word: $first_word" \
    "imperative verbs with these endings that are accepted:$imperative_exceptions"
fi

# A reference is "<change>: <task ids>" or "<change>: planning artifacts only".
# The right-hand side is what tells a reference from prose such as
# "octopus-codec: plan codecs"; the lowercase key excludes git trailers.
reference='^([a-z][a-z0-9-]*): ([0-9]+(\.[0-9]+)?(, [0-9]+(\.[0-9]+)?)*( \(.*\))?|planning artifacts only)$'

# known_change <name>: the active or archived change directory exists.
known_change() {
  [ "$1" != "archive" ] && [ -d "openspec/changes/$1" ] && return 0
  local dir
  for dir in openspec/changes/archive/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-"$1"; do
    [ -d "$dir" ] && return 0
  done
  return 1
}

# change_names: every active and archived change name, for the error message.
change_names() {
  local dir
  for dir in openspec/changes/*/ openspec/changes/archive/*/; do
    [ -d "$dir" ] || continue
    dir="${dir%/}"
    dir="${dir##*/}"
    [ "$dir" = "archive" ] && continue
    echo "${dir#[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-}"
  done | sort -u | tr '\n' ' '
}

references=0
while IFS= read -r line; do
  if [[ "$line" =~ $reference ]]; then
    references=$((references + 1))
    name="${BASH_REMATCH[1]}"
    if ! known_change "$name"; then
      refuse "unknown OpenSpec change '$name'" \
        "line: $line" \
        "existing changes: $(change_names)"
    fi
  fi
done <<< "$body"

if [ "$references" -eq 0 ] && ! grep -q '^No OpenSpec change: .' <<< "$body"; then
  refuse "commit body must cite the OpenSpec change it implements" \
    "add a line '<change>: <task ids>', for example 'quality-gates: 2.2'" \
    "or, only for files the owner exempted from OpenSpec, 'No OpenSpec change: <reason>'"
fi
